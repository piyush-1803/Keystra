{
  "name": "keystra",
  "version": "2.0.0",
  "description": "",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node start.js",
    "build": "vite build",
    "prod": "electron src/main/main.js",
    "package": "npm run build && electron-builder",
    "test": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.keystra.app",
    "productName": "Keystra",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "src/main/icon.png"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "src/hook/KeystraHook.exe",
        "to": "KeystraHook.exe"
      }
    ]
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "jest": "^30.4.2",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.3"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  }
}